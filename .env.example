# ==============================================================================
# LogiFlow Enterprise Full-Stack Production Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
# Set to 'production' for live deployment, 'development' for local tests
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="LogiFlow Enterprise Logistics API"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Domain & SSL (Used by Caddy reverse proxy)
DOMAIN_NAME=app.logiflow.io
ACME_EMAIL=admin@logiflow.io

# ------------------------------------------------------------------------------
# 2. Cryptographic Security & JWT
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=9f82d8c3b4a5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 Database
# ------------------------------------------------------------------------------
DB_USER=logiflow_user
DB_PASSWORD=logiflow_secure_pwd_2026
DB_NAME=logiflow_db
DATABASE_URL=postgresql+asyncpg://logiflow_user:logiflow_secure_pwd_2026@postgres:5432/logiflow_db
DB_ECHO=false
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=15

# ------------------------------------------------------------------------------
# 4. Redis 7 Pub/Sub & Distributed Cache
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 5. CORS & Security Headers
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://app.logiflow.io,https://logiflow.io,http://localhost:8080
ALLOWED_HOSTS=app.logiflow.io,localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 6. Eskiz.uz SMS Gateway
# ------------------------------------------------------------------------------
# Register at notify.eskiz.uz to obtain credentials
ESKIZ_EMAIL=your_eskiz_email@company.uz
ESKIZ_PASSWORD=your_eskiz_secret_password
ESKIZ_FROM=4546

# ------------------------------------------------------------------------------
# 7. WebRTC Audio Calls & Coturn TURN/STUN Server
# ------------------------------------------------------------------------------
COTURN_HOST=coturn
COTURN_PORT=3478
COTURN_REALM=logiflow.io
COTURN_SECRET=logiflow_turn_secret_key_prod_2026
STUN_SERVER_URL=stun:stun.l.google.com:19302

# ------------------------------------------------------------------------------
# 8. Payment Gateways (Uzbekistan - Payme & Click)
# ------------------------------------------------------------------------------
# Payme Merchant API
PAYME_MERCHANT_ID=payme_merchant_id_from_cabinet
PAYME_SECRET_KEY=payme_secret_key_from_cabinet

# Click Merchant API
CLICK_SERVICE_ID=click_service_id_here
CLICK_MERCHANT_ID=click_merchant_id_here
CLICK_SECRET_KEY=click_secret_key_here

# ------------------------------------------------------------------------------
# 9. Storage Vault (Local or S3/MinIO)
# ------------------------------------------------------------------------------
STORAGE_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25
S3_ENABLED=false
S3_BUCKET_NAME=logiflow-vault
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=your_s3_key
S3_SECRET_KEY=your_s3_secret
