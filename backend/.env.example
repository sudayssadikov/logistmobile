# ==============================================================================
# LogiFlow Enterprise Backend Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="LogiFlow Enterprise Logistics API"
VERSION="1.0.0"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & JWT Secrets (Generate with: openssl rand -hex 32)
SECRET_KEY=replace_with_a_64_character_cryptographically_secure_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=logiflow_user
POSTGRES_PASSWORD=replace_with_strong_password_2026
POSTGRES_DB=logiflow_db
DATABASE_URL=postgresql+asyncpg://logiflow_user:replace_with_strong_password_2026@postgres:5432/logiflow_db
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Pub/Sub
REDIS_URL=redis://redis:6379/0

# WebRTC Coturn STUN/TURN Server
COTURN_HOST=coturn
COTURN_PORT=3478
COTURN_REALM=logiflow.io
COTURN_SECRET=replace_with_turn_secret_key_prod_2026
STUN_SERVER_URL=stun:stun.l.google.com:19302

# Allowed Hosts & CORS Origins (NO wildcard '*' allowed; comma-separated explicit domains)
ALLOWED_HOSTS=localhost,127.0.0.1,app.logiflow.io,logiflow.io
CORS_ORIGINS=http://localhost:8080,https://app.logiflow.io,https://logiflow.io

# File Storage & MinIO S3
STORAGE_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25
S3_ENABLED=true
S3_BUCKET_NAME=logiflow-vault
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=replace_with_minio_access_key
S3_SECRET_KEY=replace_with_minio_secret_key

# Eskiz.uz SMS Gateway
ESKIZ_EMAIL=user@company.uz
ESKIZ_PASSWORD=eskiz_api_password
ESKIZ_FROM=4546

# Payment Providers (Production credentials)
PAYME_MERCHANT_ID=prod_payme_merchant_id
PAYME_SECRET_KEY=prod_payme_secret_key
CLICK_SERVICE_ID=prod_click_service_id
CLICK_MERCHANT_ID=prod_click_merchant_id
CLICK_SECRET_KEY=prod_click_secret_key
