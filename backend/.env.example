# ==============================================================================
# LogiFlow Enterprise Backend Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="LogiFlow Enterprise Logistics API"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & JWT Secrets (Generate with: openssl rand -hex 32)
SECRET_KEY=9f82d8c3b4a5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration
# For PostgreSQL (Production): postgresql+asyncpg://logiflow_user:logiflow_password@localhost:5432/logiflow_db
# For SQLite (Local Standalone Development): sqlite+aiosqlite:///./logiflow.db
DATABASE_URL=sqlite+aiosqlite:///./logiflow.db
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & PubSub (Leave empty to use in-memory mock fallback)
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated)
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:59954,http://127.0.0.1:59954,*

# File Upload Storage
STORAGE_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Payment Providers (Sandbox/Mock mode in development)
PAYME_MERCHANT_ID=test_payme_merchant_id
PAYME_SECRET_KEY=test_payme_secret_key
CLICK_SERVICE_ID=test_click_service_id
CLICK_MERCHANT_ID=test_click_merchant_id
CLICK_SECRET_KEY=test_click_secret_key

# SMS & Push Notification Gateway (Mock fallback for dev)
SMS_GATEWAY_API_KEY=test_sms_key
FCM_SERVER_KEY=test_fcm_key
